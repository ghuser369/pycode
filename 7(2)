import numpy as np
from sklearn.model_selection import *
from sklearn.linear_model import *
from sklearn.cluster import *
from sklearn.semi_supervised import *
from sklearn.metrics import *

X=np.array([[1,2],[2,3],[3,4],[4,5],[6,7],[7,8],[8,9],[9,10]])
y=np.array([0,0,0,0,1,1,1,1])

print("Dataset:\n",X)
print("Labels:\n",y)

print("\n===== SUPERVISED LEARNING =====")
x1,x2,y1,y2=train_test_split(X,y,test_size=.25)
m=LogisticRegression().fit(x1,y1)
p=m.predict(x2)
print("Predicted:",p)
print("Actual:",y2)
print("Accuracy:",accuracy_score(y2,p))

print("\n===== UNSUPERVISED LEARNING =====")
c=KMeans(n_clusters=2).fit(X).labels_
print("Cluster Labels:",c)
plt.scatter(X[:,0],X[:,1],c=c)
plt.title("K-Means Clustering")
plt.show()

print("\n===== SEMI-SUPERVISED LEARNING =====")
s=LabelPropagation().fit(X,[0,0,-1,-1,1,-1,-1,1]).transduction_
print("Original Labels:",y)
print("Predicted Labels:",s)

print("\n===== REINFORCEMENT LEARNING =====")
Q=np.zeros((8,2));r=y*10
for _ in range(100):
 s=np.random.randint(8)
 for _ in range(10):
  a=np.random.randint(2);n=(s+a)%8
  Q[s,a]+=.1*(r[n]+.9*np.max(Q[n])-Q[s,a]);s=n
print("Q-Table:\n",Q)
